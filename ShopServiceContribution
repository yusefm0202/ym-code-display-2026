local function sendDiscordMessage(channelId, message)
	local success, error = pcall(task.spawn, function()
		message = HttpService:JSONEncode(message)
		HttpService:PostAsync(`https://roblox-worker.joritochip.workers.dev/discord/{channelId}`, message, Enum.HttpContentType.ApplicationJson, false, {
			["Authorization"] = HttpService:GetSecret("WebhookToken")
		})
	end)
	if not success then
		warn(`Failed to send Discord message: {error}`)
	end
end

function ShopService:ReplicateSwordToPlayer(player: Player, swordName: string)
	local swordFolder = SwordsFolder:FindFirstChild(swordName)
	if not swordFolder then
		warn("Unable to replicate missing sword: " .. swordName)
		return
	end

	local playerGui = player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui", 10)
	if not playerGui then
		return
	end

	local swordClone = swordFolder:Clone()
	swordClone:SetAttribute(EXPECTED_DESCENDANTS_ATTRIBUTE, #swordClone:GetDescendants())
	CollectionService:AddTag(swordClone, REPLICATE_SWORD_TAG)
	swordClone.Parent = playerGui
end

function ShopService:ReplicateOwnedSwords(player: Player, ownedSwords)
	for _, sword in ownedSwords do
		if typeof(sword) == "table" and typeof(sword.Name) == "string" then
			ShopService:ReplicateSwordToPlayer(player, sword.Name)
		end
	end
end

function ShopService:ReplicateInitialOwnedSwords(player: Player, ownedSwords)
	if InitialSwordReplicationComplete[player]
		or not SwordReplicationReadyPlayers[player]
		or not SwordDataLoadedPlayers[player]
	then
		return false
	end

	InitialSwordReplicationComplete[player] = true
	ShopService:ReplicateOwnedSwords(player, ownedSwords)
	return true
end

function ShopService:PlayerOwnsSword(player: Player, swordName: string)
	local replica = DataService:GetReplica(player, false)
	if not replica then return end

	for _, sword in replica.Data.OwnedSwords do
		if sword.Name == swordName then
			return true
		end
	end
	return false
end

local function getGrantedSwordSet(player: Player)
	local grant = ITEM_GRANTS[player.UserId]
	local grantedSwords = {}

	if typeof(grant) == "string" then
		grantedSwords[grant] = true
	elseif typeof(grant) == "table" then
		for _, swordName in grant do
			grantedSwords[swordName] = true
		end
	end

	return grantedSwords
end

local function getPlayerNameFromUserId(userId: number?): string?
	if typeof(userId) ~= "number" then
		return nil
	end

	local player = Players:GetPlayerByUserId(userId)
	if player then
		return player.Name
	end

	local success, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	return if success then name else nil
end

local function shouldCreateSerialForSword(swordName: string): boolean
	local swordFolder = SwordsFolder:FindFirstChild(swordName)
	if not swordFolder then
		return false
	end

	local rarity = swordFolder:GetAttribute("Rarity")
	if typeof(rarity) ~= "string" then
		return false
	end

	local normalizedRarity = string.upper(rarity)
	return normalizedRarity == "GODLY" or normalizedRarity == "LEGENDARY"
end

