end

local function profileHasPendingGiftForProduct(profile, productId: number): boolean
	local hasPendingGift = false

	profile:MessageHandler(function(message)
		if typeof(message) == "table"
			and message.Type == GIFT_MESSAGE_TYPE
			and message.ProductId == productId
		then
			hasPendingGift = true
		end
	end)

	return hasPendingGift
end

local function canReceiveOneTimeProduct(userId: number, productId: number): boolean
	local swordNames = SEASONAL_PRODUCTS[productId]
	if not swordNames then
		return true
	end

	local targetPlayer = Players:GetPlayerByUserId(userId)
	if targetPlayer then
		local profile = DataService:GetProfile(targetPlayer, false)
		return profile ~= nil and not profileOwnsAnySword(profile, swordNames)
	end

	local profileAlreadyHasProduct = DataService:ReadProfileAsync(userId, function(profile)
		return profileOwnsAnySword(profile, swordNames)
			or profileHasPendingGiftForProduct(profile, productId)
	end)
	return profileAlreadyHasProduct ~= true
end

local function getPendingProductPurchase(player: Player, productId: number)
	local pendingPurchase = PendingProductPurchases[player.UserId]
	if not pendingPurchase then return nil end

	if pendingPurchase.ProductId ~= productId then
		return nil
	end

	if os.clock() - pendingPurchase.CreatedAt > PENDING_PURCHASE_TTL then
		PendingProductPurchases[player.UserId] = nil
		return nil
	end

	return pendingPurchase
end

local function clearPendingProductPurchase(player: Player, productId: number)
	local pendingPurchase = PendingProductPurchases[player.UserId]
	if pendingPurchase and pendingPurchase.ProductId == productId then
		PendingProductPurchases[player.UserId] = nil
	end
end

local function getDailyShopMemoryStoreKey(day: number): string
	return `Swords:RarityFirst:{day}`
end

local function getValidDailyShopItems(value, eligibleSwordSet: {[string]: boolean}): {string}?
	if typeof(value) ~= "table" then
		return nil
	end

	local items = {}
	local seenItems = {}
	for index = 1, DAILY_SHOP_ITEM_COUNT do
		local itemName = value[index]
		if typeof(itemName) ~= "string" or seenItems[itemName] or not eligibleSwordSet[itemName] then
			return nil
		end

		seenItems[itemName] = true
		table.insert(items, itemName)
	end

	return items
end

local function getDailyShopRarityBuckets()
	local rarityBuckets = {}
	local eligibleSwordSet = {}

	for _, sword in SwordsFolder:GetChildren() do
		if sword:GetAttribute("InDailyRotation") ~= true then
			continue
		end

		local rarityAttribute = sword:GetAttribute("Rarity")
		if typeof(rarityAttribute) ~= "string" then
			continue
		end

		local rarityName = string.upper(rarityAttribute)
		local weight = DAILY_SHOP_RARITY_WEIGHTS[rarityName]
		if not weight then
			continue
		end

		rarityBuckets[rarityName] = rarityBuckets[rarityName] or {}
		table.insert(rarityBuckets[rarityName], sword.Name)
		eligibleSwordSet[sword.Name] = true
	end

	for _, swords in pairs(rarityBuckets) do
		table.sort(swords)
	end

	return rarityBuckets, eligibleSwordSet
end

local function getDailyShopRarityBucketItemCount(rarityBuckets): number
	local count = 0
	for _, swords in pairs(rarityBuckets) do
		count += #swords
	end

	return count
end

local function cloneDailyShopRarityBuckets(rarityBuckets)
	local clonedBuckets = {}
	for rarityName, swords in pairs(rarityBuckets) do
		clonedBuckets[rarityName] = table.clone(swords)
	end

	return clonedBuckets
end

local function pickDailyShopRarity(rng: Random, rarityBuckets): string?
	local totalWeight = 0
	for _, rarityName in ipairs(DAILY_SHOP_RARITY_ORDER) do
		local swords = rarityBuckets[rarityName]
		if swords and #swords > 0 then
			totalWeight += DAILY_SHOP_RARITY_WEIGHTS[rarityName]
		end
	end

	if totalWeight == 0 then
		return nil
	end

	local selectedWeight = rng:NextNumber(0, totalWeight)
	local runningWeight = 0
	for _, rarityName in ipairs(DAILY_SHOP_RARITY_ORDER) do
		local swords = rarityBuckets[rarityName]
		if swords and #swords > 0 then
			runningWeight += DAILY_SHOP_RARITY_WEIGHTS[rarityName]
			if selectedWeight <= runningWeight then
				return rarityName
			end
		end
	end

	return nil
end

local function generateDailyShopItems(day: number, rarityBuckets): {string}
	local currentShopItems = {}
	local rng = Random.new(day)

	local eligibleSwords = cloneDailyShopRarityBuckets(rarityBuckets)
	for _ = 1, math.min(DAILY_SHOP_ITEM_COUNT, getDailyShopRarityBucketItemCount(eligibleSwords)) do
		local rarityName = pickDailyShopRarity(rng, eligibleSwords)
		if not rarityName then
			break
		end

		local swords = eligibleSwords[rarityName]
		local swordIndex = rng:NextInteger(1, #swords)
		table.insert(currentShopItems, swords[swordIndex])
		table.remove(swords, swordIndex)
	end

	return currentShopItems
end

local function getDailyShopItems(day: number, rarityBuckets, eligibleSwordSet: {[string]: boolean}, timeleft: number): {string}
	local cacheKey = getDailyShopMemoryStoreKey(day)
	local cacheExpiration = timeleft + DAILY_SHOP_CACHE_BUFFER
	local generatedShopItems

	local success, value = pcall(DailyShopMemoryStore.UpdateAsync, DailyShopMemoryStore, cacheKey, function(cachedValue)
		local cachedShopItems = getValidDailyShopItems(cachedValue, eligibleSwordSet)
		if cachedShopItems then
			return cachedShopItems
		end

		generatedShopItems = generateDailyShopItems(day, rarityBuckets)
		sendDiscordMessage(SHOP_LOG_CHANNEL_ID, {
			content = `Daily shop items generated for day {day}: {table.concat(generatedShopItems, ", ")}`,
		})

		return generatedShopItems
	end, cacheExpiration)

	if success then
		local cachedShopItems = getValidDailyShopItems(value, eligibleSwordSet)
		if cachedShopItems then
			return cachedShopItems
		end
	else
		warn(`Unable to update daily shop MemoryStore cache: {value}`)
	end

	return generatedShopItems or generateDailyShopItems(day, rarityBuckets)
end

function ShopService:DeliverGiftMessage(player: Player, message, processed: () -> ())
	if message.Type == ADMIN_STUD_GRANT_MESSAGE_TYPE then
		local studsAmount = message.StudsAmount
		if typeof(studsAmount) ~= "number" then
			processed()
			return
		end

		if ShopService:GrantStuds(player, studsAmount) then
			processed()
			queueStudGrantNotification(player, studsAmount)
		end
		return
	end

	if message.Type ~= GIFT_MESSAGE_TYPE then
		return
	end

	local productId = message.ProductId
	if typeof(productId) ~= "number" then
		processed()
		return
	end

	if STUD_PRODUCTS[productId] then
		local studsAmount = STUD_PRODUCTS[productId]
		if ShopService:GrantStuds(player, studsAmount) then
			processed()
			queueGiftNotification(player, studsAmount, nil, message.SenderUserId, message.SenderName)
		end
		return
	end

	local swordNames = SEASONAL_PRODUCTS[productId]
	if swordNames then
		local success = ShopService:GrantSwords(player, swordNames, message.Serials)
		if success then
			processed()
			queueGiftNotification(player, nil, swordNames, message.SenderUserId, message.SenderName)
		end
		return
	end

	processed()
end

function ShopService:DeliverProductPurchase(player: Player, productId: number, receiptInfo): boolean
	local pendingPurchase = getPendingProductPurchase(player, productId)
	local targetUserId = if pendingPurchase then pendingPurchase.TargetUserId else player.UserId
	local targetPlayer = Players:GetPlayerByUserId(targetUserId)

	if pendingPurchase and targetUserId ~= player.UserId then
		local giftSwordNames = SEASONAL_PRODUCTS[productId]
		local serials = if giftSwordNames then ShopService:CreateSerialsForSwords(giftSwordNames) else nil

		local success = DataService:MessageProfileAsync(targetUserId, {
			Type = GIFT_MESSAGE_TYPE,
			ProductId = productId,
			SenderUserId = player.UserId,
			SenderName = player.Name,
			PurchaseId = if receiptInfo then receiptInfo.PurchaseId else nil,
			CreatedAt = DateTime.now().UnixTimestamp,
			Serials = serials,
		})

		if success then
			local productString = `**unknown product {productId}**`
			if STUD_PRODUCTS[productId] then
				productString = `**{STUD_PRODUCTS[productId]} studs**`
			elseif SEASONAL_PRODUCTS[productId] then
				local swordStrings = {}
				for _, swordName in SEASONAL_PRODUCTS[productId] do
					local serial = serials and serials[swordName]
					table.insert(swordStrings, `**{swordName}**{if serial then ` (#{serial})` else ""}`)
				end
				productString = table.concat(swordStrings, ", ")
			end

			local targetName = if targetPlayer then targetPlayer.Name else `UserId {targetUserId}`
			pcall(function()
				targetName = Players:GetNameFromUserIdAsync(targetUserId)
			end)

			sendDiscordMessage(PURCHASE_LOG_CHANNEL_ID, {
				content = `**{player.Name}** ({player.UserId}) gifted {productString} to **{targetName}** ({targetUserId}) for {receiptInfo.CurrencySpent} Robux ({productId})`,
			})
			clearPendingProductPurchase(player, productId)
		end

		return success
	end

	local success = false
	if STUD_PRODUCTS[productId] then
		sendDiscordMessage(PURCHASE_LOG_CHANNEL_ID, {
			content = `**{player.Name}** ({player.UserId}) purchased **{STUD_PRODUCTS[productId]} studs** for {receiptInfo.CurrencySpent} Robux ({productId})`,
		})
		success = ShopService:GrantStuds(targetPlayer or player, STUD_PRODUCTS[productId])
	elseif SEASONAL_PRODUCTS[productId] then
		local grantSuccess, entries = ShopService:GrantSwords(targetPlayer or player, SEASONAL_PRODUCTS[productId])
		success = grantSuccess
		local productString = ""
		for _, entry in entries do
			productString ..= `**{entry.Name}** {if entry.Serial then `(#{entry.Serial})` else ""}, `
		end
		productString = productString:sub(1, -2)
		sendDiscordMessage(PURCHASE_LOG_CHANNEL_ID, {
			content = `**{player.Name}** ({player.UserId}) purchased {productString} for {receiptInfo.CurrencySpent} Robux ({productId})`,
		})
	end

	if success then
		clearPendingProductPurchase(player, productId)
	end

	return success
end

function ShopService.Client:PromptProductPurchase(player: Player, productId: number, targetPlayerOrUserId: Player|number?)
	if typeof(productId) ~= "number" then return false end
	if not STUD_PRODUCTS[productId] and not SEASONAL_PRODUCTS[productId] then return false end

	local targetUserId = player.UserId
	if typeof(targetPlayerOrUserId) == "Instance" and targetPlayerOrUserId:IsA("Player") then
		targetUserId = targetPlayerOrUserId.UserId
	elseif typeof(targetPlayerOrUserId) == "number" then
		targetUserId = targetPlayerOrUserId
	end

	if not canReceiveOneTimeProduct(targetUserId, productId) then
		return false
	end

	PendingProductPurchases[player.UserId] = {
		ProductId = productId,
		TargetUserId = targetUserId,
		CreatedAt = os.clock(),
	}

	MarketService:PromptProduct(player, productId)
	return true
end

function ShopService.Client:PurchaseSword(player: Player, swordName: string)
	local swordFolder = SwordsFolder:FindFirstChild(swordName)
	if not swordFolder then return end

	local price = swordFolder:GetAttribute("Price")
	if typeof(price) ~= "number" then
		warn("Price not set for sword: " .. swordName)
		return
	end

	local replica = DataService:GetReplica(player, false)
	if not replica then return end
	
	if ShopService:PlayerOwnsSword(player, swordName) then return end
	
	if replica.Data.Studs < price then return end
	
	replica:Set({"Studs"}, replica.Data.Studs - price)
	local entry = ShopService:GrantSword(player, swordName)

	sendDiscordMessage(STUD_PURCHASE_LOG_CHANNEL_ID, {
		content = `**{player.Name}** ({player.UserId}) purchased **{swordName}** ({swordFolder:GetAttribute("Rarity") or "?"}{if entry.Serial then `, #{entry.Serial}` else ""}) for {price} Studs`,
	})
end

function ShopService.Client:AcknowledgeShopNotification(player: Player, notificationId: string)
	if typeof(notificationId) ~= "string" then return end

	local replica = DataService:GetReplica(player, false)
	if not replica then return end

	for index, notification in ipairs(replica.Data.ShopNotifications) do
		if typeof(notification) == "table" and notification.Id == notificationId then
			replica:TableRemove({"ShopNotifications"}, index)
			return
		end
	end
end

function ShopService.Client:AcknowledgeReplicatedSword(player: Player, swordName: string)
	if typeof(swordName) ~= "string" then return end

	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return end

	for _, child in ipairs(playerGui:GetChildren()) do
		if child.Name == swordName and CollectionService:HasTag(child, REPLICATE_SWORD_TAG) then
			child:Destroy()
		end
	end
end

function ShopService.Client:EquipSword(player: Player, swordName: string?)
	local replica = DataService:GetReplica(player, false)
	if not replica then return end

	if swordName == nil then
		replica:Set({"EquippedSword"}, nil)
		player:SetAttribute("EquippedSword", nil)
		return
	end
	
	if not ShopService:PlayerOwnsSword(player, swordName) then return end
	
	replica:Set({"EquippedSword"}, swordName)
	player:SetAttribute("EquippedSword", swordName)
end

function ShopService.Client:RequestSwordReplication(player: Player)
	SwordReplicationReadyPlayers[player] = true

	if not SwordDataLoadedPlayers[player] then
		return false
	end

	local replica = DataService:GetReplica(player, false)
	if not replica then
		return false
	end

	return ShopService:ReplicateInitialOwnedSwords(player, replica.Data.OwnedSwords)
end

function ShopService:KnitStart()
	-- Register product purchases
	for productId in STUD_PRODUCTS do
		MarketService:ListenForProductPurchase(productId, function(player: Player, receiptInfo)
			return ShopService:DeliverProductPurchase(player, productId, receiptInfo)
		end)
	end

	for productId in SEASONAL_PRODUCTS do
		MarketService:ListenForProductPurchase(productId, function(player: Player, receiptInfo)
			return ShopService:DeliverProductPurchase(player, productId, receiptInfo)
		end)
	end
	
	-- Handle player data load
	DataService.PlayerDataLoaded:Connect(function(player, record)
		local replica = record.Replica

		ShopService:ReconcileItemGrants(player, replica)
		SwordDataLoadedPlayers[player] = true
		ShopService:ReplicateInitialOwnedSwords(player, replica.Data.OwnedSwords)

		if replica.Data.EquippedSword then
			player:SetAttribute("EquippedSword", replica.Data.EquippedSword)
		end

		local profile = DataService:GetProfile(player)
		if profile then
			profile:MessageHandler(function(message, processed)
				ShopService:DeliverGiftMessage(player, message, processed)
			end)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		PendingProductPurchases[player.UserId] = nil
		SwordReplicationReadyPlayers[player] = nil
		SwordDataLoadedPlayers[player] = nil
		InitialSwordReplicationComplete[player] = nil
	end)
	
	-- Update shop loop
	ClientSwordsFolder:ClearAllChildren()

	for _,swords in SEASONAL_PRODUCTS do
		for _,swordName in swords do
			if not ClientSwordsFolder:FindFirstChild(swordName) then
				local sword = SwordsFolder:FindFirstChild(swordName)
				if sword then
					sword:Clone().Parent = ClientSwordsFolder
				end
			end
		end
	end

	task.spawn(function()
		while true do
			local t = DateTime.now().UnixTimestamp
			local day = math.floor(t / (60 * 60 * 24)) 
			local timeleft = 86400 - (t % 86400)
			timeLeftValue.Value = timeleft

			if day ~= currentDayValue.Value then
				currentDayValue.Value = day

				currentRotation:ClearAllChildren()

				local rarityBuckets, eligibleSwordSet = getDailyShopRarityBuckets()
				local currentShopItems = getDailyShopItems(day, rarityBuckets, eligibleSwordSet, timeleft)
				
				for _, itemName in ipairs(currentShopItems) do
					local v = Instance.new("StringValue")
					v.Name = itemName
					v.Value = itemName
					v.Parent = currentRotation

					if not ClientSwordsFolder:FindFirstChild(itemName) then
						local sword = SwordsFolder:FindFirstChild(itemName)
						if sword then
							sword:Clone().Parent = ClientSwordsFolder
						end
					end
				end
				print("Updated shop items.")
			end
			task.wait(1)
		end
	end)
end

function ShopService:KnitInit()
	DataService = Knit.GetService("DataService")
	MarketService = Knit.GetService("MarketService")
end

return ShopService
