function ShopService:ReconcileItemGrants(player: Player, replica)
	local grantedSwords = getGrantedSwordSet(player)
	local ownedGrantedSwords = {}
	local updatedSwords = {}
	local didChange = false

	for _, sword in replica.Data.OwnedSwords do
		local isCurrentGrant = grantedSwords[sword.Name] == true

		if sword.IsItemGrant and not isCurrentGrant then
			didChange = true
			if replica.Data.EquippedSword == sword.Name then
				replica:Set({"EquippedSword"}, nil)
				player:SetAttribute("EquippedSword", nil)
			end
			continue
		end

		if isCurrentGrant then
			ownedGrantedSwords[sword.Name] = true

			if not sword.IsItemGrant then
				local updatedSword = table.clone(sword)
				updatedSword.IsItemGrant = true
				table.insert(updatedSwords, updatedSword)
				didChange = true
				continue
			end
		end

		table.insert(updatedSwords, sword)
	end

	for swordName in grantedSwords do
		if not ownedGrantedSwords[swordName] then
			table.insert(updatedSwords, {
				Name = swordName,
				CreatedAt = DateTime.now().UnixTimestamp,
				IsItemGrant = true,
			})
			didChange = true
		end
	end

	if didChange then
		replica:Set({"OwnedSwords"}, updatedSwords)
	end
end

function ShopService:CreateSerial(swordName: string)
	local success, newSerial = pcall(SerialDataStore.UpdateAsync, SerialDataStore, swordName, function(old)
		if old == nil then
			old = 0
		end
		return old + 1
	end)
	return success, newSerial
end

function ShopService:CreateSerialsForSwords(swordNames: {string}): {[string]: number}
	local serials = {}
	for _, swordName in swordNames do
		if shouldCreateSerialForSword(swordName) then
			local success, newSerial = ShopService:CreateSerial(swordName)
			serials[swordName] = if success then newSerial else -1
		end
	end
	return serials
end

function ShopService:GrantSword(player: Player, swordName: string, serial: number?)
	local replica = DataService:GetReplica(player, false)
	if not replica then return end

	local entry = {
		Name = swordName,
		CreatedAt = DateTime.now().UnixTimestamp
	}

	if serial ~= nil then
		entry.Serial = serial
	elseif shouldCreateSerialForSword(swordName) then
		local success, newSerial = ShopService:CreateSerial(swordName)
		entry.Serial = if success then newSerial else -1
	end

	if InitialSwordReplicationComplete[player] then
		ShopService:ReplicateSwordToPlayer(player, swordName)
	end
	replica:TableInsert({"OwnedSwords"}, entry)

	return entry
end

function ShopService:GrantStuds(player: Player, studsAmount: number): boolean
	local replica = DataService:GetReplica(player, false)
	if not replica then return false end

	replica:Set({"Studs"}, math.max(0, replica.Data.Studs + studsAmount))

	return true
end

function ShopService:GrantSwords(player: Player, swordNames: {string}, serials: {[string]: number}?): (boolean, {any})
	local entries = {}
	local success = true

	for _, swordName in swordNames do
		if ShopService:PlayerOwnsSword(player, swordName) then continue end
		local entry = ShopService:GrantSword(player, swordName, serials and serials[swordName])
		if entry then
			table.insert(entries, entry)
		else
			success = false
		end
	end

	return success, entries
end

local function profileOwnsAnySword(profile, swordNames: {string}): boolean
	for _, swordName in swordNames do
		for _, sword in profile.Data.OwnedSwords do
			if sword.Name == swordName then
				return true
			end
		end
	end

